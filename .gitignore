# Dependencies
node_modules/
.pnpm-store/

# Build output (never committed; see DEVELOPMENT_GUIDE.md)
dist/
build/
.vite/
*.tsbuildinfo

# Generated documentation (TypeDoc output is a CI artifact)
docs/api/

# Test and coverage output
coverage/
playwright-report/
test-results/

# Environment files: real values live in host secrets. Only the example is tracked.
.env
.env.*
!.env.example

# Local git worktrees
.worktrees/
worktrees/

# Logs
*.log
npm-debug.log*
pnpm-debug.log*

# Editors and OS
.idea/
.vscode/
.DS_Store
Thumbs.db

# Written by tools/snapshot.sh --git-state while the zip is made
GIT_STATE.txt
