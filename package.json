{
  "name": "minesweeper",
  "version": "0.0.0",
  "private": true,
  "license": "UNLICENSED",
  "description": "Competitive Minesweeper: 1v1 races on an identical seeded board plus solo time-attack.",
  "type": "module",
  "packageManager": "pnpm@12.15.0",
  "engines": {
    "node": ">=24.15.0"
  },
  "scripts": {
    "typecheck": "tsc -b && pnpm typecheck:tests",
    "typecheck:tests": "tsc -p packages/engine/tsconfig.test.json && tsc -p packages/protocol/tsconfig.test.json && tsc -p tsconfig.tooling.json",
    "build": "tsc -b",
    "lint": "eslint .",
    "format": "prettier --write \"**/*.{ts,tsx,mts,cts,js,mjs,cjs,json,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,mts,cts,js,mjs,cjs,json,yml,yaml}\"",
    "check:todos": "node scripts/check-todos.mjs",
    "check:links": "node scripts/check-links.mjs",
    "audit:prod": "pnpm audit --prod --audit-level moderate",
    "audit:all": "pnpm audit --audit-level high",
    "test:lint-fixtures": "node --test tools/lint-fixtures/lint-fixtures.test.mjs",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:affected": "node scripts/test-affected.mjs",
    "docs:api": "typedoc",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "@eslint/js": "10.0.1",
    "@types/node": "24.19.2",
    "@vitest/coverage-v8": "5.0.5",
    "eslint": "10.13.0",
    "eslint-plugin-jsdoc": "65.4.0",
    "eslint-plugin-tsdoc": "0.5.4",
    "husky": "9.1.7",
    "lint-staged": "17.6.0",
    "prettier": "3.9.10",
    "typedoc": "0.28.20",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
